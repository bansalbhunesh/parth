# Pramaan Environment Variables
# Copy to .env and fill in your keys.
# NOTE: everything works WITHOUT any key — the app degrades to the
# deterministic rule-based engine and bundled ground-truth data. Keys are
# only needed for: live LLM analysis, streaming copilot, LLM eval path.

# --- LLM provider: gemini (default) | qwen (any /v1 gateway) | claude | ollama ---
# PRAMAAN_LLM picks the PRIMARY. If more than one provider below is configured,
# the app fails over automatically on quota/429/rate-limit/timeout in this order:
#   gemini -> qwen gateway -> groq -> claude -> local ollama -> deterministic rules
# Configure only the ones you have; a single-key setup behaves exactly as before
# (every other leg is filtered out). Override the whole order with
# PRAMAAN_LLM_PROVIDER_ORDER (comma-separated, e.g. "gemini,qwen,claude").
# /llm-check reports the live chain, which provider last answered, the last
# failover reason, and that the deterministic floor is always available.
# Failover is for reliability/availability, NOT accuracy — the rule engine is
# always the safe floor and computes from the real documents (never seeded labels).
# NOTE: a listed leg is only LIVE if its key is set AND the account has quota/
# credit. The hosted demo pins "gemini,qwen,groq": the gateway leg is funded
# (aicredits.in) and pinned to the benchmark-featured model, and claude is left
# out of the order because no key exists (re-add both together). Always confirm
# with /llm-check?probe_all=1 before claiming a leg works.
PRAMAAN_LLM=gemini
# PRAMAAN_LLM_PROVIDER_ORDER=gemini,qwen,groq   # hosted-demo order; add claude/ollama only when configured

# Native Google Gemini (AI Studio key, free tier).
# Keep the model pinned: 2.0-flash 429s on free keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Seconds the sync /analyze path waits for the LLM before degrading to the
# rule-based fallback (streaming is uncapped).
PRAMAAN_LLM_TIMEOUT=60

# PS4 layers (schedule risk, supply chain, project graph). Default on;
# set to 0 to hide a section.
PRAMAAN_SCHEDULE=1
PRAMAAN_SUPPLY=1
PRAMAAN_GRAPH=1

# --- OCR (scanned/image-only PDFs + directly-uploaded images) ---
# Needs the `tesseract` SYSTEM binary (Dockerfile.backend installs it; the plain
# Python buildpack does not). GET /ocr-check reports whether OCR will actually
# run in this deployment. Everything degrades to an honest "OCR unavailable"
# message when the binary is missing — never a crash.
PRAMAAN_OCR_ENABLED=1          # "0" disables OCR everywhere (alias: PRAMAAN_OCR)
PRAMAAN_OCR_DPI=300            # scanned-PDF rasterization DPI (speed vs accuracy)
PRAMAAN_MAX_PDF_PAGES=30       # cap on pages OCR'd per PDF (bounds latency/memory)
PRAMAAN_MAX_IMAGE_PIXELS=20000000   # reject larger images (decompression-bomb guard)
# TESSERACT_CMD=/usr/bin/tesseract    # path to the binary if not on PATH
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata   # language-data dir

# --- Failover leg: OpenAI-compatible gateway (kept behind Gemini). Fills
# in automatically when a key is present; leave blank to run Gemini-only. ---
# MUST be a genuinely separate provider/quota (e.g. aicredits.in, OpenRouter) —
# NOT Google's OpenAI-compatible endpoint, which would just re-spend Gemini's
# quota. /llm-check flags this as separate_quota=false if you point it at Google.
# Hosted-demo config (aicredits.in, funded 2026-07-06, benchmark-featured model):
# QWEN_GATEWAY_API_KEY=sk-live-...            # (older alias: OPENAI_API_KEY)
# QWEN_GATEWAY_BASE_URL=https://aicredits.in/v1        # (alias: OPENAI_BASE_URL)
# QWEN_GATEWAY_MODEL=google/gemini-3.1-flash-lite      # (alias: OPENAI_MODEL)
# QWEN_GATEWAY_JSON_MODE=1                              # (alias: OPENAI_JSON_MODE)
# QWEN_GATEWAY_MAX_TOKENS=4000  # gateways default low and truncate long JSON
# Alternative (OpenRouter + Qwen3-235B, 0.82 recall on the real pairs):
#   base https://openrouter.ai/api/v1 · model qwen/qwen3-235b-a22b-2507

# --- Spend guard: per-provider hourly call budgets (0/unset = unlimited). A
# PAID leg should always carry one: once exhausted the leg fails over like any
# provider failure (next leg / free rule floor) — availability degrades
# gracefully, spend stays capped. Counts ATTEMPTS, process-local, single
# instance. /llm-check reports budget_per_hour + budget_used_last_hour. ---
# QWEN_GATEWAY_BUDGET_PER_HOUR=30       # (alias: OPENAI_BUDGET_PER_HOUR)
# GEMINI_BUDGET_PER_HOUR=0
# GROQ_BUDGET_PER_HOUR=0
# CLAUDE_BUDGET_PER_HOUR=0

# --- Insurance leg: Groq (free tier, its own quota).
# Chain: gemini -> qwen gateway -> groq -> claude -> ollama -> rule floor.
# Groq has good recall but a mild over-flag tendency, so it sits behind Qwen. ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile   # default; also on Groq: openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # default; override only for a proxy

# --- Failover leg: Anthropic Claude (also usable as the primary brain) ---
# CLAUDE_API_KEY=sk-ant-...            # (older alias: ANTHROPIC_API_KEY)
# CLAUDE_MODEL=claude-opus-4-8

# --- Last LLM leg: local Ollama (keyless; needs no network/quota). Keeps the
# demo answering even fully offline, just before the deterministic rule floor.
# Off unless LOCAL_LLM_ENABLED=1. The model must be pulled locally first
# (e.g. `ollama pull llama3.1`). ---
# LOCAL_LLM_ENABLED=1
# OLLAMA_BASE_URL=http://localhost:11434   # default
# OLLAMA_MODEL=llama3.1

# ── Public-demo security hardening (Phase 5) ─────────────────────────
# Demo hardening, NOT production security. See docs/SECURITY_DEMO_RUNBOOK.md.

# Optional token gate on the EXPENSIVE endpoints (analysis, upload, vision,
# copilot, /llm-check). OFF by default so the judge demo is open. To enable,
# set BOTH: the flag AND a strong token. Callers then send the token as an
# `X-Demo-Token` header, `Authorization: Bearer <token>`, or `?token=`.
# The token is NEVER logged, echoed, or placed in any response or /health.
# NOTE: enabling this means the hosted frontend's interactive panels need the
# token supplied at request time — do NOT bake it into the frontend bundle.
DEMO_AUTH_ENABLED=false
# DEMO_AUTH_TOKEN=change-me-to-a-long-random-string

# Process-local rate limiting (per client IP, sliding 1-hour window). ON by
# default with generous caps. Single-instance only — a real deployment would
# use a shared store (Redis) behind a trusted proxy. Disable for load tests.
PRAMAAN_RATE_LIMIT_ENABLED=true
PRAMAAN_ANALYSIS_LIMIT_PER_HOUR=20
PRAMAAN_UPLOAD_LIMIT_PER_HOUR=10
PRAMAAN_DEEP_PROBE_LIMIT_PER_HOUR=3

# Per-file upload cap (declared + actual bytes are both enforced). Combined with
# the OCR caps above (PRAMAAN_MAX_PDF_PAGES, PRAMAAN_MAX_IMAGE_PIXELS).
PRAMAAN_MAX_UPLOAD_MB=20

# Optional CORS allowlist. The default permits only the hosted frontend and
# localhost development origins; replace it with deployment-specific origins.
# PRAMAAN_CORS_ORIGINS=https://parth-tan.vercel.app

# --- Managed production platform -------------------------------------------
# Local/demo keeps SQLite, in-process jobs/cache, and case-secret ownership.
# Production refuses to start unless all four managed backends are selected.
PRAMAAN_ENV=local
PRAMAAN_AUTH_BACKEND=demo
PRAMAAN_CASE_BACKEND=sqlite
PRAMAAN_QUEUE_BACKEND=memory
PRAMAAN_CACHE_BACKEND=memory

# Required together for PRAMAAN_ENV=production. Keep all values server-only.
# SUPABASE_URL=https://project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_AUDIENCE=authenticated
# DATABASE_URL=postgresql://postgres.project-ref:password@host:5432/postgres
# PRAMAAN_REDIS_URL=rediss://default:password@host:6379
# PRAMAAN_STORAGE_BUCKET=case-documents

# Private operational endpoint. An unset token makes /internal/metrics return 404.
# PRAMAAN_METRICS_TOKEN=generate-a-long-random-value

# Organization defaults; migration-level defaults match these values.
PRAMAAN_RAW_UPLOAD_RETENTION_DAYS=30
PRAMAAN_AUDIT_RETENTION_DAYS=365

# --- Frontend (Vercel / frontend/.env.local) ---
# NEXT_PUBLIC_API=https://parth-1-ma30.onrender.com
