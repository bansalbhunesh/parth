# Pramaan Environment Variables
# Copy to .env and fill in your keys.
# NOTE: everything works WITHOUT any key — the app degrades to the
# deterministic rule-based engine and bundled ground-truth data. Keys are
# only needed for: live LLM analysis, streaming copilot, LLM eval path.

# --- LLM provider: gemini (default) | openai (any /v1 gateway) | claude ---
# PRAMAAN_LLM picks the PRIMARY. If more than one provider below is configured,
# the app fails over automatically on quota/429/timeout in this order:
#   gemini  ->  openai gateway (e.g. Qwen)  ->  claude  ->  deterministic rules
# Configure only the ones you have; a single-key setup behaves exactly as before.
# /llm-check reports the live chain, which provider last answered, and the last
# failover reason. Failover is for reliability, not accuracy — the rule engine
# is always the safe floor.
PRAMAAN_LLM=gemini

# Native Google Gemini (AI Studio key, free tier).
# Keep the model pinned: 2.0-flash 429s on free keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Seconds the sync /analyze path waits for the LLM before degrading to the
# rule-based fallback (streaming is uncapped).
PRAMAAN_LLM_TIMEOUT=60

# PS4 layers (schedule risk, supply chain, project graph). Default on;
# set to 0 to hide a section.
PRAMAAN_SCHEDULE=1
PRAMAAN_SUPPLY=1
PRAMAAN_GRAPH=1

# --- Failover leg: OpenAI-compatible gateway (kept behind Gemini). Fills in
# automatically when a key is present; leave blank to run Gemini-only. ---
# Verified config (OpenRouter + Qwen3-235B, 0.82 recall on the real pairs):
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=qwen/qwen3-235b-a22b-2507
# OPENAI_JSON_MODE=1
# OPENAI_MAX_TOKENS=4000       # gateways default low and truncate long JSON

# --- Second failover leg: Groq (free tier, its own quota — full insurance).
# Chain becomes gemini -> qwen gateway -> groq -> claude -> rule floor.
# Groq has good recall but a mild over-flag tendency, so it sits behind Qwen. ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile   # default; also on Groq: openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # default; override only for a proxy

# --- Alternative: Anthropic Claude (A/B on the reconciliation brain) ---
# ANTHROPIC_API_KEY=

# --- Frontend (Vercel / frontend/.env.local) ---
# NEXT_PUBLIC_API=https://parth-3puc.onrender.com
