# Pramaan Environment Variables
# Copy to .env and fill in your keys

# LLM Provider (gemini or claude)
PRAMAAN_LLM=gemini

# Gemini API Key (required for LLM eval + live analysis)
GEMINI_API_KEY=

# Claude API Key (alternative to Gemini)
ANTHROPIC_API_KEY=

# NOTE: All features work WITHOUT API keys using ground-truth fallback data.
# API keys only needed for: live analysis, streaming copilot, LLM eval path.
