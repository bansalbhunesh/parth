{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:3100/"],
      "numberOfRuns": 5,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["warn", { "minScore": 1.0 }]
      }
    }
  }
}
